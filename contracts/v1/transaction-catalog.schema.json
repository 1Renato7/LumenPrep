{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lumen.local/contracts/v1/transaction-catalog.schema.json",
  "title": "CTR-TXN-001 Transaction Catalog v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "max_batch_size", "merchants", "providers", "issuer_banks", "countries", "currencies", "payment_method_categories", "card_brands", "card_types", "correlation_id"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "max_batch_size": {"type": "integer", "minimum": 1, "maximum": 100},
    "merchants": {"$ref": "#/$defs/options"},
    "providers": {"$ref": "#/$defs/options"},
    "issuer_banks": {"$ref": "#/$defs/options"},
    "countries": {"$ref": "#/$defs/options"},
    "currencies": {"$ref": "#/$defs/options"},
    "payment_method_categories": {"$ref": "#/$defs/options"},
    "card_brands": {"$ref": "#/$defs/options"},
    "card_types": {"$ref": "#/$defs/options"},
    "correlation_id": {"type": "string", "minLength": 1}
  },
  "$defs": {
    "options": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
  }
}
