{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lumen.local/contracts/v1/transaction-sample-response.schema.json",
  "title": "CTR-TXN-001 Transaction Sample Response v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "seed", "transactions", "correlation_id"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "seed": {"type": "integer", "minimum": 0},
    "transactions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {"$ref": "transaction-input.schema.json"}
    },
    "correlation_id": {"type": "string", "minLength": 1}
  }
}
