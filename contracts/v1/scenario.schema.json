{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lumen.local/contracts/v1/scenario.schema.json",
  "title": "CTR-SCN-001 Scenario Definition v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "scenario_id", "seed", "start_at", "duration_seconds", "filters", "effects"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "scenario_id": {"type": "string", "minLength": 1},
    "seed": {"type": "integer", "minimum": 0},
    "start_at": {"type": "string", "format": "date-time"},
    "duration_seconds": {"type": "integer", "minimum": 1},
    "filters": {
      "type": "object",
      "additionalProperties": {"type": "array", "minItems": 1, "items": {"type": "string"}}
    },
    "effects": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "approval_rate_multiplier": {"type": "number", "minimum": 0, "maximum": 2},
        "latency_p95_multiplier": {"type": "number", "minimum": 0},
        "timeout_rate": {"type": "number", "minimum": 0, "maximum": 1},
        "decline_code_distribution": {
          "type": "object",
          "additionalProperties": {"type": "number", "minimum": 0, "maximum": 1}
        }
      },
      "minProperties": 1
    }
  }
}
