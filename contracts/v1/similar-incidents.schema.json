{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lumen.local/contracts/v1/similar-incidents.schema.json",
  "title": "CTR-MEM-001 Similar Incident Result v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "query_incident_id", "matches", "retrieval_trace", "correlation_id"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "query_incident_id": {"type": "string"},
    "matches": {"type": "array", "items": {"type": "object", "required": ["incident_id", "occurred_at", "confirmation", "structured_score", "matching_factors", "different_factors", "confirmed_cause", "prior_playbook_id", "evidence_ids"], "properties": {"incident_id": {"type": "string"}, "occurred_at": {"type": "string", "format": "date-time"}, "confirmation": {"const": "HUMAN_CONFIRMED"}, "structured_score": {"type": "number", "minimum": 0, "maximum": 1}, "semantic_score": {"type": ["number", "null"], "minimum": 0, "maximum": 1}, "matching_factors": {"type": "array", "items": {"type": "string"}}, "different_factors": {"type": "array", "items": {"type": "string"}}, "confirmed_cause": {"type": "string"}, "prior_playbook_id": {"type": "string"}, "evidence_ids": {"type": "array", "items": {"type": "string"}}}}},
    "retrieval_trace": {"type": "object", "required": ["cypher_filter", "candidate_count", "embedding_model", "index_version", "fallback_used"], "properties": {"cypher_filter": {"type": "string"}, "candidate_count": {"type": "integer", "minimum": 0}, "embedding_model": {"type": ["string", "null"]}, "index_version": {"type": "string"}, "fallback_used": {"type": "boolean"}}},
    "correlation_id": {"type": "string"}
  }
}
