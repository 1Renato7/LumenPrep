{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lumen.local/contracts/v1/transaction-batch-accepted.schema.json",
  "title": "CTR-TXN-001 Transaction Batch Accepted v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "batch_id", "accepted_at", "status", "transaction_ids", "correlation_id"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "batch_id": {"type": "string", "minLength": 1},
    "accepted_at": {"type": "string", "format": "date-time"},
    "status": {"const": "PROCESSING"},
    "transaction_ids": {"type": "array", "minItems": 1, "maxItems": 100, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "correlation_id": {"type": "string", "minLength": 1}
  }
}
