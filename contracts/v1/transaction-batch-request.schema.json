{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lumen.local/contracts/v1/transaction-batch-request.schema.json",
  "title": "CTR-TXN-001 Transaction Batch Request v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "idempotency_key", "transactions"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "idempotency_key": {"type": "string", "minLength": 8, "maxLength": 100},
    "transactions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {"$ref": "transaction-input.schema.json"}
    }
  }
}
