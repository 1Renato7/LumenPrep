{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lumen.local/contracts/v1/agent-retrieval-trace.schema.json",
  "title": "CTR-AGT-002 RetrievalTrace v1",
  "description": "What the agent retrieved, from which authorized source, at which version and score. NO_PRECEDENT is a fact recorded here, not an instruction to stop investigating. Retrieved text is untrusted data and never grants authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "incident_id",
    "status",
    "filter_criteria",
    "candidate_count",
    "index_version",
    "fallback_used",
    "sources",
    "authorized_evidence_ids"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "incident_id": {"type": "string", "minLength": 1},
    "status": {"enum": ["MATCH_FOUND", "NO_PRECEDENT", "MEMORY_UNAVAILABLE"]},
    "filter_criteria": {"type": "string", "minLength": 1},
    "candidate_count": {"type": "integer", "minimum": 0},
    "index_version": {"type": "string", "minLength": 1},
    "fallback_used": {"type": "boolean"},
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source", "source_id", "version", "score", "summary", "evidence_ids"],
        "properties": {
          "source": {"type": "string", "minLength": 1, "description": "incident_memory or playbook_catalog; no vector store or web source exists in v1."},
          "source_id": {"type": "string", "minLength": 1},
          "version": {"type": "string", "minLength": 1},
          "score": {"type": ["number", "null"]},
          "summary": {"type": "string", "minLength": 1},
          "evidence_ids": {"type": "array", "items": {"type": "string", "minLength": 1}}
        }
      }
    },
    "authorized_evidence_ids": {"type": "array", "items": {"type": "string", "minLength": 1}}
  }
}
