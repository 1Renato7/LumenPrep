{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lumen.example/contracts/incident-confirmation-request.schema.json",
  "title": "CTR-MEM-PROMOTE-001 Human Confirmation Request",
  "type": "object",
  "additionalProperties": false,
  "required": ["review_id", "reviewer_id", "confirmed_cause", "playbook_id", "decline_codes", "temporal_shape", "provenance"],
  "properties": {
    "review_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "reviewer_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "confirmed_cause": {"type": "string", "minLength": 1, "maxLength": 128},
    "playbook_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "decline_codes": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"type": "string", "minLength": 1}},
    "temporal_shape": {"type": "string", "minLength": 1, "maxLength": 128},
    "provenance": {"const": "REAL_HUMAN_REVIEW"}
  }
}
