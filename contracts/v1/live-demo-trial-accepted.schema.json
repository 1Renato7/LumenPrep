{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "trial_id", "flow", "execution_mode", "baseline_batch_ids", "batch_id", "accepted_at", "status", "transaction_ids", "correlation_id"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "trial_id": {"type": "string", "enum": ["deterministic", "graph_enriched"]},
    "flow": {"type": "string", "enum": ["DETERMINISTIC", "GRAPH_ENRICHED"]},
    "execution_mode": {"const": "QUEUED_SAFE"},
    "baseline_batch_ids": {"type": "array", "minItems": 1, "maxItems": 1, "items": {"type": "string"}},
    "batch_id": {"type": "string"},
    "accepted_at": {"type": "string"},
    "status": {"const": "PROCESSING"},
    "transaction_ids": {"type": "array", "minItems": 25, "maxItems": 25, "items": {"type": "string"}},
    "correlation_id": {"type": "string"}
  }
}
